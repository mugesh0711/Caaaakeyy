# Copy this file to ".env" (in the backend folder) to change settings on your computer.
# On Vercel/Railway, set these in the dashboard instead. Everything is optional.

PORT=5000

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If left as is, a key is generated automatically and saved with the data.
JWT_SECRET=change-me-to-a-long-random-string

# How long a login stays valid (in hours)
TOKEN_TTL_HOURS=168

# Optional: use Upstash Redis instead of the backend/data/db.json file
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token
